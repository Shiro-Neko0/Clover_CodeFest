# --- Server (never commit the real .env) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/care-aide?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Check the current model name in Google AI Studio if this one stops working
GEMINI_MODEL=gemini-3.8-flash

# --- Browser (these are public by design; Vite only exposes names starting with VITE_) ---
VITE_CLOUDINARY_CLOUD=your-cloud-name
VITE_CLOUDINARY_PRESET=your-unsigned-upload-preset
