                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"SOS pressed\"\n}"
            }
          }
        },
        {
          "name": "Caregiver overview (caregiver token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            }
          }
        }
      ]
    }
  ]
}