{
  "info": {
    "name": "Cakna API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run \"Register elder\" or \"Login\" first. It saves the token for the other requests. Switch to the caregiver by running \"Login caregiver\"."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "doseId",
      "value": ""
    },
    {
      "key": "medId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register elder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"token\", j.token); }",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pak Hassan\",\n  \"email\": \"hassan@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"elder\"\n}"
            }
          }
        },
        {
          "name": "Register caregiver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"token\", j.token); }",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aisyah\",\n  \"email\": \"aisyah@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"caregiver\"\n}"
            }
          }
        },
        {
          "name": "Login elder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"token\", j.token); }",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hassan@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login caregiver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"token\", j.token); }",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.code).to.be.below(300));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aisyah@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Me (shows linkCode for elder)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Link caregiver to elder (caregiver token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "link"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"PASTE-THE-ELDER-CODE\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Check-in and health (elder token)",
      "item": [
        {
          "name": "Check-in message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checkins/message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkins",
                "message"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"from\": \"bot\",\n      \"text\": \"How did you sleep last night?\"\n    },\n    {\n      \"from\": \"user\",\n      \"text\": \"Not so good, maybe 5 hours\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Week of check-ins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checkins/week",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkins",
                "week"
              ]
            }
          }
        },
        {
          "name": "Meals today",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meals"
              ]
            }
          }
        },
        {
          "name": "Analyze meal photo (paste base64)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meals/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meals",
                "analyze"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageBase64\": \"PASTE_BASE64_JPEG\",\n  \"mimeType\": \"image/jpeg\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Medicine",
      "item": [
        {
          "name": "Add medicine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metformin\",\n  \"dose\": \"500 mg, 1 tablet after breakfast\",\n  \"times\": [\n    \"08:00\",\n    \"20:00\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Today slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meds/today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meds",
                "today"
              ]
            }
          }
        },
        {
          "name": "Mark taken (set medId first)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meds/{{medId}}/take",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meds",
                "{{medId}}",
                "take"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"time\": \"08:00\",\n  \"videoUrl\": \"https://example.com/video.mp4\"\n}"
            }
          }
        },
        {
          "name": "Dose video log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meds/doses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meds",
                "doses"
              ]
            }
          }
        },
        {
          "name": "Add caregiver note (caregiver token, set doseId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/meds/doses/{{doseId}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meds",
                "doses",
                "{{doseId}}",
                "notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Looks good. Remember to drink water.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Diabetes follow-up\",\n  \"place\": \"Klinik Kesihatan\",\n  \"date\": \"2026-10-20\",\n  \"time\": \"10:30\",\n  \"remind\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "AI chat and alerts",
      "item": [
        {
          "name": "Ask clover",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"from\": \"user\",\n      \"text\": \"Can I take my pills with tea?\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Ask clover (emergency words skip the AI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"from\": \"user\",\n      \"text\": \"I have chest pain\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "SOS (elder token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
